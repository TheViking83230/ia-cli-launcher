// Installateur d'IA CLI Launcher : icône, logo.
#pragma code_page(65001)
#include <winver.h>
#include "resource.h"

IDI_APP ICON "../build/icon.ico"
IDR_LOGO RCDATA "../build/icons/256x256.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1, 0, 0, 0
 PRODUCTVERSION 1, 0, 0, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "TheViking83230"
      VALUE "FileDescription", "Installation d'IA CLI Launcher"
      VALUE "ProductName", "IA CLI Launcher"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
